+const fn create_causal_arr<const S: usize, const N: usize>() -> [u8; N] {
+    let mut arr = [0u8; N];
+    let mut i = 0;
+    while i < N {
+        let row = (i / S) % S;
+        let col = i % S;
+        arr[i] = if col > row { 1 } else { 0 };
+        i += 1;
+    }
+    arr
+}
