+// House patch: CANDLE_METAL_BACKWARD_SYNC_EVERY=N (0/unset = off) synchronizes
+// the metal device every N backward nodes. This was the workaround for the
+// pre-fix rank>=5 strided-reduce indexer bug (get_strided_idx_fallback in
+// reduce.metal, fixed on upstream main): it changed buffer-pool adjacency so
+// the out-of-bounds loads read benign memory. The bug is fixed; the knob stays
+// so the fenced path that produced published training numbers remains
+// reproducible. Read per backward() call, not cached, so setting or clearing
+// the env mid-process (tests, in-process job runners) always takes effect.
+fn metal_backward_sync_every() -> usize {
+    std::env::var("CANDLE_METAL_BACKWARD_SYNC_EVERY")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(0)
+}
