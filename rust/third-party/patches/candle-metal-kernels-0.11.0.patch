+
+const SPLIT_K_TILE: usize = 32;
+const SPLIT_K_BK: usize = 16;
+const SPLIT_K_IS_OPT_IN_BECAUSE_SUMMING_PARTIALS_REASSOCIATES_THE_K_SUM: &str =
+    "CANDLE_METAL_GEMM_SPLITK";
+
+thread_local! {
+    static SPLIT_K_SCOPES_THIS_THREAD_IS_INSIDE: std::cell::Cell<usize> =
+        const { std::cell::Cell::new(0) };
+}
+
+pub fn with_split_k_on_this_thread_unless_the_environment_decides<T>(
+    encode: impl FnOnce() -> T,
+) -> T {
+    struct Leave;
+    impl Drop for Leave {
+        fn drop(&mut self) {
+            SPLIT_K_SCOPES_THIS_THREAD_IS_INSIDE.with(|scopes| scopes.set(scopes.get() - 1));
+        }
+    }
+    SPLIT_K_SCOPES_THIS_THREAD_IS_INSIDE.with(|scopes| scopes.set(scopes.get() + 1));
+    let _leave = Leave;
+    encode()
+}
+
+fn split_k_is_enabled() -> bool {
+    static ENVIRONMENT_DECIDES: std::sync::OnceLock<Option<bool>> = std::sync::OnceLock::new();
+    ENVIRONMENT_DECIDES
+        .get_or_init(|| {
+            std::env::var_os(SPLIT_K_IS_OPT_IN_BECAUSE_SUMMING_PARTIALS_REASSOCIATES_THE_K_SUM)
+                .map(|_| {
+                    crate::utils::get_env_bool(
+                        SPLIT_K_IS_OPT_IN_BECAUSE_SUMMING_PARTIALS_REASSOCIATES_THE_K_SUM,
+                        false,
+                    )
+                })
+        })
+        .unwrap_or_else(|| SPLIT_K_SCOPES_THIS_THREAD_IS_INSIDE.with(|scopes| scopes.get() > 0))
+}
+
+fn split_k_routes(device_type: MetalDeviceType, b: usize, m: usize, n: usize, k: usize) -> bool {
+    let grid_starved_below_tiles = match device_type {
+        MetalDeviceType::Max | MetalDeviceType::Ultra => 2048,
+        _ => 1024,
+    };
+    b == 1
+        && m.min(n) >= 40
+        && m.div_ceil(16) * n.div_ceil(16) <= grid_starved_below_tiles
+        && k / SPLIT_K_BK >= 8
+        && k >= m.max(n)
+}
+
+fn split_k_partials(device: &Device, bytes: usize) -> Result<Buffer, MetalKernelError> {
+    thread_local! {
+        static PARTIALS: std::cell::RefCell<Option<(u64, Buffer)>> =
+            const { std::cell::RefCell::new(None) };
+    }
+    PARTIALS.with(|held| {
+        let mut held = held.borrow_mut();
+        let id = device.registry_id();
+        if !matches!(&*held, Some((owner, buffer)) if *owner == id && buffer.length() >= bytes) {
+            *held = Some((id, device.new_buffer(bytes, crate::RESOURCE_OPTIONS)?));
+        }
+        Ok(held.as_ref().unwrap().1.clone())
+    })
+}
+
+#[allow(clippy::too_many_arguments)]
+fn call_mlx_gemm_split_k(
+    device: &Device,
+    ep: impl EncoderProvider,
+    kernels: &Kernels,
+    dtype: GemmDType,
+    (m, n, k): (usize, usize, usize),
+    (lda, ldb): (i32, i32),
+    (a_trans, b_trans): (bool, bool),
+    (lhs_buffer, lhs_offset): (&Buffer, usize),
+    (rhs_buffer, rhs_offset): (&Buffer, usize),
+    output: &Buffer,
+) -> Result<(), MetalKernelError> {
+    #[repr(C)]
+    struct SplitKParams {
+        m: i32,
+        n: i32,
+        k: i32,
+        lda: i32,
+        ldb: i32,
+        ldc: i32,
+        tiles_n: i32,
+        tiles_m: i32,
+        partitions: i32,
+        partition_stride: i32,
+        partition_size: i32,
+        gemm_k_iterations_aligned: i32,
+    }
+    impl EncoderParam for SplitKParams {
+        fn set_param(encoder: &ComputeCommandEncoder, position: usize, data: Self) {
+            encoder.set_bytes(position, &data);
+        }
+    }
+    let (tiles_m, tiles_n) = (m.div_ceil(SPLIT_K_TILE), n.div_ceil(SPLIT_K_TILE));
+    let partitions = ((k / SPLIT_K_BK) / (tiles_m * tiles_n))
+        .next_power_of_two()
+        .clamp(2, 32);
+    let iterations = (k / SPLIT_K_BK) / partitions;
+    let partials = split_k_partials(device, partitions * m * n * 4)?;
+    let dtype_str = match dtype {
+        GemmDType::F32 => "f32",
+        GemmDType::F16 => "f16",
+        GemmDType::BF16 => "bf16",
+    };
+    let trans_str = match (a_trans, b_trans) {
+        (false, false) => "nn",
+        (true, false) => "tn",
+        (false, true) => "nt",
+        (true, true) => "tt",
+    };
+    let k_str = if k % SPLIT_K_BK == 0 { "kt" } else { "kn" };
+    let encoder = ep.encoder();
+    let encoder: &ComputeCommandEncoder = encoder.as_ref();
+    let pipeline = kernels.load_pipeline(
+        device,
+        Source::Gemm,
+        format!("gemm_splitk_{trans_str}_{dtype_str}_{k_str}"),
+    )?;
+    encoder.set_compute_pipeline_state(&pipeline);
+    set_params!(
+        encoder,
+        (
+            (lhs_buffer, lhs_offset),
+            (rhs_buffer, rhs_offset),
+            Output::new(&partials),
+            SplitKParams {
+                m: m as i32,
+                n: n as i32,
+                k: k as i32,
+                lda,
+                ldb,
+                ldc: n as i32,
+                tiles_n: tiles_n as i32,
+                tiles_m: tiles_m as i32,
+                partitions: partitions as i32,
+                partition_stride: (m * n) as i32,
+                partition_size: (iterations * SPLIT_K_BK) as i32,
+                gemm_k_iterations_aligned: iterations as i32,
+            }
+        )
+    );
+    encoder.dispatch_thread_groups(
+        MTLSize {
+            width: tiles_n,
+            height: tiles_m,
+            depth: partitions,
+        },
+        MTLSize {
+            width: 32,
+            height: 2,
+            depth: 2,
+        },
+    );
+    let pipeline = kernels.load_pipeline(
+        device,
+        Source::Gemm,
+        format!("gemm_splitk_accum_{dtype_str}"),
+    )?;
+    encoder.set_compute_pipeline_state(&pipeline);
+    set_params!(
+        encoder,
+        (
+            &partials,
+            Output::new(output),
+            partitions as i32,
+            (m * n) as i32,
+            n as i32
+        )
+    );
+    encoder.dispatch_threads(
+        MTLSize {
+            width: n,
+            height: m,
+            depth: 1,
+        },
+        crate::utils::get_block_dims(n, m, 1),
+    );
+    Ok(())
+}
