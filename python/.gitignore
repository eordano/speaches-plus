# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Nix
result
result-*

# Editor / OS
.vscode/
.idea/
.DS_Store

# Local env / secrets
.env
.env.*

# Claude Code local state (skills + commands under .claude/ ARE committed;
# this file is per-process locking state)
.claude/scheduled_tasks.lock

# Local work
temp/
speaches-plus/
speaches-plus
review_fixes_flamegraph.html

# Test capture artifacts (inspect_api audio_store leaks these into cwd
# when INSPECT_SESSION_DIR isn't set during test runs)
sess_*.raw
sess_*.ndjson
sess_*.audio.json
.claude/worktrees
