.DS_Store
*.log

# editor / IDE
*.swp
*.swo
*~
.vscode/
.idea/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# environment / secrets
.env
.env.*
!.env.example

# large model / fixture artifacts
*.npy
*.bin
*.onnx
*.gguf
client/fixtures/*.wav

# go / rust build outputs
go/server
go/coverage.out
target/

# working temporary files
temp/

# dev-shell snapshots (direnv + scripts/dev-env.sh)
.direnv/
go/bin/
rust/models/

# macOS AppleDouble sidecars
._*

# realtime session audio dumps (inspect audio_store writes these to CWD)
sess_*.raw
sess_*.ndjson
sess_*.audio.json
rocq/.nia.cache

# lane-local shader temp files: a sweep must never publish these
*.wgsl.tmp.*
*.tmp.[0-9]*

# fitted Kokoro voices shipped with the code (1 KB each; the flake only sees tracked files)
!rust/voices/*.npy
!python/tts/kokoro/voices/*.npy
sae-runs/

# model weights, databases and secrets must never be tracked
*.safetensors
*.pt
*.pth
*.ckpt
*.db
*.sqlite
*.sqlite3
*.parquet
outputs/
