{
 "_doc": [
  "Declared inputs for the rocq/gen/extract/* CUDA extractors.",
  "Both directions are checked: a declared path that is missing is a refusal,",
  "and a .cu under corpus_root that is not declared here is also a refusal.",
  "A file genuinely out of scope must be listed with \"extract\": \"none\" and a",
  "reason, so exclusions are reviewable data rather than a smaller number.",
  "Toolchain paths are machine pins: either set the env var named in each",
  "entry, or repin \"path\" to a local store path matching expect_substring."
 ],
 "toolchain": {
  "libclang": {
   "env": "NV_LIBCLANG",
   "path": "",
   "expect_substring": "clang-21.1.8"
  },
  "cuda": {
   "env": "CUDA_PATH",
   "path": "",
   "expect_substring": "cuda-merged-12.9"
  },
  "cutlass": {
   "env": "CUTLASS_DIR",
   "path": "",
   "expect_substring": "-source"
  },
  "flashinfer": {
   "env": "FLASHINFER_DIR",
   "path": "",
   "expect_substring": "-source"
  },
  "gcc": {
   "env": "NV_GCC_DIR",
   "path": "",
   "expect_substring": "gcc-15.3.0"
  },
  "glibc": {
   "env": "NV_GLIBC_DEV",
   "path": "",
   "expect_substring": "glibc-2.42"
  }
 },
 "offload_arch": "sm_120",
 "cxx_std": "c++17",
 "include_roots": [
  "$REPO/rust/crates/nv-kernels/include",
